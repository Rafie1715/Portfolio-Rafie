rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    // Preferred: set a custom claim { admin: true } on your admin account.
    function hasAdminClaim() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    // Do not grant database privileges to a hardcoded email/domain.
    // Assign { admin: true } using the owner-only recovery script before deploying rules.
    function isAdmin() {
      return hasAdminClaim();
    }

    // Public catalogs are served by Functions with publication/field filtering.
    // Direct reads would expose every field of a published CMS document.
    match /projects/{projectId} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Certification public reads also go through the filtered catalog API.
    match /certifications/{certificationId} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Public AFK curated movie picks + admin CMS write access.
    match /moviePicks/{pickId} {
      allow read: if isAdmin() || resource.data.isPublished == true;
      allow create, update, delete: if isAdmin();
    }

    // Public AFK watchlist + admin CMS write access.
    match /movieWatchlist/{itemId} {
      allow read: if isAdmin() || resource.data.isPublished == true;
      allow create, update, delete: if isAdmin();
    }

    // Public AFK reaction leaderboard.
    match /reactionScores/{scoreId} {
      allow read: if true;
      // Writes go through the validated, rate-limited engagement function.
      allow create: if false;
      allow update, delete: if false;
    }

    // Default deny for all other collections/documents.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
