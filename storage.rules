rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Portfolio images are public; uploading uses the owner's existing Firebase login.
    match /portfolio/{uid}/{filename} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if isAdmin()
        && request.auth.uid == uid
        && filename.matches('^[a-zA-Z0-9-]+[.](jpg|png|webp)$')
        && request.resource.size > 0
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if isAdmin() && request.auth.uid == uid;
      // Uploads always get a fresh ID, so existing image URLs cannot be overwritten.
      allow update: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
